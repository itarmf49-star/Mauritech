generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  CUSTOMER
}

model User {
  id Int @id @default(autoincrement())
  name     String?
  email    String   @unique
  password String
  role     Role     @default(CUSTOMER)

  phone    String?
  info     String?

  accounts Account[]
  sessions Session[]

  billingInvoices BillingInvoice[]
  clientAccounts ClientAccount[]
  messages Message[]
  aiConversations AiConversation[]
  coveragePlans CoveragePlan[]
  portalProjects PortalProject[]
  supportTickets SupportTicket[]
  portalDocuments PortalDocument[]
  
  cart Cart?
  orders Order[]
  reviews Review[]
  wishlist Wishlist?
  customer Customer?
  chatSessions ChatSession[]
  aiAgentConversations AIAgentConversation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String?
  category    String?
  description String?
  imageUrl    String?
  videoUrl    String?
  isPublished Boolean  @default(true)

  translations ProjectTranslation[]
  images       ProjectImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model ProjectTranslation {
  id          String @id @default(cuid())
  projectId   String
  locale      String
  title       String
  description String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  body      String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("Message")
}

model SiteSettings {
  id        String  @id @default(cuid())
  siteName  String  @default("MauriTech")
  seoTitle  String?
  seoDesc   String?
  ogImage   String?
  facebook  String?
  instagram String?
  x         String?
  youtube   String?

  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Int      @default(0)
  comparePrice Int?
  cost        Int?
  images      Json?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  sku         String?  @unique
  barcode     String?  @unique
  weight      Float?
  dimensions  Json?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  tags        String[]
  
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean  @default(true)
  
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(0)
  reservedQty     Int      @default(0)
  lowStockThreshold Int    @default(5)
  trackQuantity   Boolean  @default(true)
  allowBackorder  Boolean  @default(false)
  lastRestocked   DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("inventory")
}

model Cart {
  id        String   @id @default(cuid())
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?  @unique
  items     CartItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress Json?
  billingAddress  Json?
  
  subtotal        Int
  tax             Int           @default(0)
  shipping        Int           @default(0)
  discount        Int           @default(0)
  total           Int
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentIntentId String?       @unique
  
  notes           String?
  source          String        @default("web")
  
  items           OrderItem[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  productSku  String?
  quantity    Int
  unitPrice   Int
  total       Int
  
  createdAt   DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  rating    Int
  comment   String?
  isVerified Boolean @default(false)
  isApproved Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  items     WishlistItem[]
  
  createdAt DateTime @default(now())
  
  @@map("wishlists")
}

model WishlistItem {
  id        String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  
  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Customer {
  id           String   @id @default(cuid())
  userId       Int?     @unique
  user         User?    @relation(fields: [userId], references: [id])
  email        String   @unique
  firstName    String
  lastName     String
  phone        String?
  company      String?
  addresses    Json?
  totalOrders  Int      @default(0)
  totalSpent   Int      @default(0)
  notes        String?
  tags         String[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([email])
  @@index([userId])
  @@map("customers")
}

model Requirement {
  id          String            @id @default(cuid())
  title       String
  description String?
  category    RequirementCategory @default(PRODUCT)
  priority    RequirementPriority @default(MEDIUM)
  status      RequirementStatus  @default(OPEN)
  source      String?            @default("web")
  contactName String?
  contactEmail String?
  contactPhone String?
  budget      Int?
  deadline    DateTime?
  assignedTo  String?
  notes       String?
  metadata    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@map("requirements")
}

model ChatSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  customerName String?
  customerEmail String?
  customerPhone String?
  status      ChatStatus @default(ACTIVE)
  assignedTo  String?
  aiHandled   Boolean  @default(false)
  metadata    Json?
  
  messages    ChatMessage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderType  ChatSender @default(CUSTOMER)
  senderName  String?
  content     String
  isAi        Boolean  @default(false)
  isRead      Boolean  @default(false)
  attachments Json?
  
  createdAt   DateTime @default(now())
  
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model SocialIntegration {
  id          String   @id @default(cuid())
  platform    SocialPlatform
  isActive    Boolean  @default(true)
  config      Json?
  webhookUrl  String?
  apiKey      String?
  apiSecret   String?
  phoneNumber String?
  displayName String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([platform])
  @@map("social_integrations")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  phoneNumber String
  messageId   String?  @unique
  direction   MessageDirection @default(INBOUND)
  content     String
  status      WhatsAppStatus @default(RECEIVED)
  orderId     String?
  customerId  String?
  metadata    Json?
  
  createdAt   DateTime @default(now())
  
  @@index([phoneNumber])
  @@index([orderId])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

model AIAgent {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  systemPrompt String
  model       String   @default("gpt-4o-mini")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(1000)
  capabilities Json?
  config      Json?
  
  conversations AIAgentConversation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("ai_agents")
}

model AIAgentConversation {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId   String?
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  customerEmail String?
  title       String?
  context     Json?
  
  messages    AIAgentMessage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([agentId])
  @@index([sessionId])
  @@index([userId])
  @@map("ai_agent_conversations")
}

model AIAgentMessage {
  id            String   @id @default(cuid())
  conversationId String
  conversation   AIAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role          String
  content       String
  tokensUsed    Int      @default(0)
  metadata      Json?
  
  createdAt     DateTime @default(now())
  
  @@index([conversationId])
  @@map("ai_agent_messages")
}

model Sale {
  id          String   @id @default(cuid())
  orderId     String   @unique
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
  total       Int
  cost        Int?
  profit      Int?
  channel     String   @default("web")
  paymentMethod String?
  
  createdAt   DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
  @@map("sales")
}

model PageView {
  id          String   @id @default(cuid())
  path        String
  referrer    String?
  userAgent   String?
  ipAddress   String?
  sessionId   String?
  duration    Int?
  
  createdAt   DateTime @default(now())
  
  @@index([path])
  @@index([sessionId])
  @@index([createdAt])
  @@map("page_views")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  eventName   String
  properties  Json?
  userId      String?
  sessionId   String?
  
  createdAt   DateTime @default(now())
  
  @@index([eventType])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ChatStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  TRANSFERRED
}

enum ChatSender {
  CUSTOMER
  AGENT
  SYSTEM
  AI
}

enum RequirementCategory {
  PRODUCT
  SERVICE
  SUPPORT
  CONSULTATION
  CUSTOM
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequirementStatus {
  OPEN
  IN_PROGRESS
  QUOTED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum SocialPlatform {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TWITTER
  TELEGRAM
  WECHAT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

model ClientAccount {
  id        String   @id @default(cuid())
  userId    Int      @unique
  company   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([userId])
  @@map("PortalAccount")
}  

model Invoice {
  id        String   @id @default(cuid())
  accountId String
  amount    Float
  status    String   @default("pending")
  issuedAt  DateTime @default(now())

  account ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items   InvoiceItem[]

  @@index([accountId])
  @@index([status])
  @@index([issuedAt])
  @@map("PortalInvoice")
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String
  title     String
  price     Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("PortalInvoiceItem")
}

model Message {
  id        String   @id @default(cuid())
  userId    Int
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("PortalMessage")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model BillingInvoice {
  id        String        @id @default(cuid())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    InvoiceStatus @default(DRAFT)
  currency  String        @default("MRU")
  subtotal  Int           @default(0)
  tax       Int           @default(0)
  total     Int           @default(0)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BillingInvoiceItem[]

  @@index([userId])
  @@index([status])
  @@map("Invoice")
}

model BillingInvoiceItem {
  id          String         @id @default(cuid())
  invoiceId   String
  invoice     BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int            @default(1)
  unitPrice   Int
  total       Int

  @@index([invoiceId])
  @@map("InvoiceItem")
}

model ServiceProduct {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  description   String
  basePrice     Int
  currency      String  @default("MRU")
  specs         Json?
  isActive      Boolean @default(true)
  postsIncluded Int     @default(0)
  color         String?
  location      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PricingRule {
  id        String  @id @default(cuid())
  name      String
  priority  Int     @default(0)
  match     Json
  price     Int
  currency  String  @default("MRU")
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AiConversation {
  id        String   @id @default(cuid())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    Int?
  model     String
  tokens    Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   Int?
  action    String
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}  

model CoveragePlan {
  id                  String @id @default(cuid())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  areaSqm             Int
  floors              Int
  wallLossDb          Int
  rooms               Int?
  wallType            String?
  desiredSpeedMbps    Int?
  deviceCount         Int?
  recommendedAps      Int
  recommendedSwitches Int
  recommendedOutlets  Int?

  floorPlanJson       Json?
  recommendationsJson Json?

  equipmentCost Int?
  installCost   Int?
  totalCost     Int?

  coverageQuality String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum EquipmentType {
  ROUTER
  ACCESS_POINT
  MESH_NODE
}

model NetworkEquipment {
  id              String        @id @default(cuid())
  name            String
  manufacturer    String
  deviceType      EquipmentType
  price           Int
  coverageRadiusM Float
  maxUsers        Int
  imageUrl        String?
  specs           Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([deviceType])
}

model InstallationPricing {
  id        String @id @default(cuid())

  name      String
  unit      String
  basePrice Int

  currency String @default("MRU")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([unit])
}

enum RequestType {
  SITE_SURVEY
  INSTALLATION
  CONSULTATION
}

enum RequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id String @id @default(cuid())

  type   RequestType
  status RequestStatus @default(NEW)

  name    String
  email   String?
  phone   String?
  address String?
  notes   String?

  estimateId String?

  userId Int?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model PortalProject {
  id String @id @default(cuid())

  userId Int

  title   String
  summary String?

  status   String @default("active")
  progress Int    @default(0)

  startedAt DateTime?
  dueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model SupportTicket {
  id String @id @default(cuid())

  userId Int

  title       String
  description String

  status   String @default("open")
  priority String @default("normal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updates SupportTicketUpdate[]

  @@index([userId])
  @@index([status])
}

model SupportTicketUpdate {
  id String @id @default(cuid())

  ticketId String

  authorId Int?

  message String

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model PortalDocument {
  id String @id @default(cuid())

  userId Int

  title    String
  fileType String?
  url      String
  sizeBytes Int?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
